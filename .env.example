# =============================================================================
# TikTok Live Games — Environment Configuration
# Copy file này thành .env và điền giá trị thật
# =============================================================================

# -----------------------------------------------------------------------------
# TIKTOK_PROVIDER — chọn provider kết nối TikTok Live
# -----------------------------------------------------------------------------
#   "session"  Hoàn toàn MIỄN PHÍ. Không cần API key.
#              Lấy ttwid + roomId trực tiếp từ TikTok page.
#              Khuyến nghị cho cá nhân / hobby.
#
#   "tiktool"  Miễn phí (free tier). Cần SIGN_API_KEY từ tik.tools.
#              Free: 5,000 req/ngày · 3 stream đồng thời.
#              Đăng ký: https://tik.tools/pricing
#
#   "euler"    Trả phí. Cần SIGN_API_KEY từ eulerstream.com.
#              Webcast signing yêu cầu Business plan.
#              Đăng ký: https://www.eulerstream.com
# -----------------------------------------------------------------------------
TIKTOK_PROVIDER=session

# -----------------------------------------------------------------------------
# SIGN_API_KEY — API key của provider (bắt buộc với "tiktool" và "euler")
# Bỏ qua nếu dùng TIKTOK_PROVIDER=session
# -----------------------------------------------------------------------------
# SIGN_API_KEY=your_api_key_here

# -----------------------------------------------------------------------------
# Session Cookie — chỉ dùng khi TIKTOK_PROVIDER=session (optional)
# Cung cấp để vào được members-only lives và kết nối ổn định hơn.
#
# Cách lấy:
#   1. Mở Chrome, đăng nhập TikTok
#   2. Vào F12 → Application → Cookies → https://www.tiktok.com
#   3. Copy giá trị của "sessionid" và "tt-target-idc"
# -----------------------------------------------------------------------------
# TIKTOK_SESSION_ID=your_sessionid_cookie_here
# TIKTOK_TT_IDC=your_tt-target-idc_cookie_here
